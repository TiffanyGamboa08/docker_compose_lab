# Ejemplo de archivo .env – reemplaza todos los valores `change_me` antes de usar

# Puertos
FRONTEND_PORT=change_me
API_PORT=change_me

# URL que usará el frontend para comunicarse con la API
VITE_API_URL=change_me

# Base de datos / Postgres
POSTGRES_CONTAINER_NAME=change_me
POSTGRES_IMAGE=change_me
POSTGRES_DB=change_me
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=change_me
POSTGRES_CONTAINER_PORT=change_me
POSTGRES_DATA_VOLUME=change_me

# Cadena de conexión (opcional)
DATABASE_URL=change_me
